# Plenty backend settings. Copy to backend/.env (read from the directory uvicorn starts in).
# Every setting is optional; the values below are the defaults.

# Postgres from `docker compose up -d` (repo root). In production, paste the Neon URL;
# postgres:// and postgresql:// URLs are accepted as-is.
PLENTY_DATABASE_URL=postgresql+psycopg://plenty:plenty@localhost:5433/plenty

# Origins allowed to call the API with credentials (JSON list).
PLENTY_CORS_ORIGINS=["http://localhost:5173"]

# Sign-up is open only until the first account exists. Set true to let more people sign up.
PLENTY_ALLOW_SIGNUP=false

# If set, only this email may create the first account, so nobody can claim a fresh deploy.
# PLENTY_OWNER_EMAIL=you@example.com

# Send the session cookie over HTTPS only. Must be true in production (the Docker image sets it).
PLENTY_COOKIE_SECURE=false

# How many days a sign-in lasts.
PLENTY_SESSION_DAYS=30

# Directory with the built web app to serve. The Docker image sets this; leave unset locally.
# PLENTY_STATIC_DIR=
